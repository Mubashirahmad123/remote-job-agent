GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT=keys.json
GEMINI_API_KEY=
MODEL=gemini/gemini-2.5-flash

RUN_MODE=crewai  # crewai (default), simple, test, apply, resume

# Optional: Adzuna free API credentials
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Scraper settings
JOBSPY_RESULTS_PER_SITE=20
JOBSPY_DELAY=3
PLAYWRIGHT_HEADLESS=true

# CV Matching
CV_PATH=my_cv.pdf
MIN_MATCH_SCORE=70

# Location / Country Filter (comma-separated, lowercase)
# Jobs matching these country terms will be included
ALLOWED_COUNTRIES=uk,united kingdom,new zealand,nz,usa,united states

# Auto-apply (optional — set to true to auto-apply to top jobs after pipeline)
AUTO_APPLY_ENABLED=false

# Auto-apply settings
AUTO_APPLY_THRESHOLD=70       # Minimum match score to auto-apply
AUTO_APPLY_LIMIT=5            # Max jobs to apply per run
AUTO_APPLY_PLAYWRIGHT=false   # true = auto-fill forms; false = just open browser
AUTO_APPLY_CONFIRM=false      # true = actually submit forms (DANGER); false = fill & review

# Your profile for auto-filling applications
APPLICANT_NAME=Mubashir
APPLICANT_EMAIL=your@email.com
APPLICANT_PHONE=+1234567890
APPLICANT_LINKEDIN=https://linkedin.com/in/yourprofile
APPLICANT_PORTFOLIO=https://yourportfolio.com
APPLICANT_GITHUB=https://github.com/yourprofile

# LLM Fallback (optional — GLM-4 and Ollama for when Gemini hits rate limits)
GLM_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Embedding Matcher (optional — install sentence-transformers + faiss-cpu)
EMBEDDING_MODEL=all-MiniLM-L6-v2
CV_EMBEDDINGS_PATH=cv_embeddings.pkl
