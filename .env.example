GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT=keys.json
GEMINI_API_KEY=
MODEL=gemini/gemini-2.5-flash

RUN_MODE=crewai  # crewai (default), simple, or test

# Optional: Adzuna free API credentials
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Scraper settings
JOBSPY_RESULTS_PER_SITE=20
JOBSPY_DELAY=3
PLAYWRIGHT_HEADLESS=true

# CV Matching
CV_PATH=my_cv.pdf
MIN_MATCH_SCORE=70
