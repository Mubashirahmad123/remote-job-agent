GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT=keys.json
GEMINI_API_KEY=
MODEL=gemini/gemini-2.5-flash

RUN_MODE=crewai  # crewai (default), simple, test, apply, resume

# Optional: Adzuna free API credentials
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Scraper settings
ENABLE_JOBSPY=false  # true = run LinkedIn/Indeed via python-jobspy in an isolated child process
JOBSPY_RESULTS_PER_SITE=20
JOBSPY_DELAY=3
JOBSPY_SITES=linkedin,indeed  # subset of linkedin,indeed,zip_recruiter
JOBSPY_TERMS=backend developer  # comma-separated; 1 term default keeps the run fast
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Container timezone (scheduler Mon/Thu 9AM uses this; override per host)
TZ=Asia/Kolkata

# CV Matching
CV_PATH=my_cv.pdf
CV_DIR=  # optional: folder of CV variants (cvs/); when set, best CV is picked per job, CV_PATH is the fallback
MIN_MATCH_SCORE=70
CLEANUP_DAYS=30          # Remove jobs older than this many days from sheet

# Location / Country Filter (OBSOLETE — code ignores this; edit ALLOWED_COUNTRY_TERMS in agents/scrapper.py)
# Jobs matching these country terms will be included
ALLOWED_COUNTRIES=uk,united kingdom,new zealand,nz,usa,united states

# Auto-apply (optional — set to true to auto-apply to top jobs after pipeline)
AUTO_APPLY_ENABLED=false

# Auto-apply settings
AUTO_APPLY_THRESHOLD=75       # Minimum match score to auto-apply
AUTO_APPLY_LIMIT=5            # Max jobs to apply per run
AUTO_APPLY_PLAYWRIGHT=false   # true = auto-fill forms; false = just open browser
AUTO_APPLY_CONFIRM=false      # legacy flag, ignored everywhere (CLI blind submit permanently removed)

# Matching / tiers
TIER_BATCH_MAX=75
TIER_DREAM_THRESHOLD=90

# Your profile for auto-filling applications
APPLICANT_NAME=Mubashir
APPLICANT_EMAIL=your@email.com
APPLICANT_PHONE=+1234567890
APPLICANT_LINKEDIN=https://linkedin.com/in/yourprofile
APPLICANT_PORTFOLIO=https://yourportfolio.com
APPLICANT_GITHUB=https://github.com/yourprofile

# LLM Fallback (Gemini -> Groq -> Mistral -> GLM -> Ollama)
GLM_API_KEY=
GLM_MODEL=glm-4
# Zhipu GLM endpoint base (tools/glm_client.py). Only set this behind a proxy or
# for a regional endpoint; the default is Zhipu's public API. GLM is called over
# plain HTTP like the Groq/Mistral rungs — there is no zhipuai SDK dependency.
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# required only for Ollama Cloud (https://ollama.com); leave empty for local server
OLLAMA_API_KEY=

# Embedding Matcher (optional — install sentence-transformers + faiss-cpu)
EMBEDDING_MODEL=all-MiniLM-L6-v2
CV_EMBEDDINGS_PATH=cv_embeddings.pkl

# API (Phase 1 reads — api/app.py + api/cache.py)
# Local dev: leave API_HOST=127.0.0.1. Docker compose overrides it to 0.0.0.0
# (required for the api container) and that bind needs API_TOKEN below.
API_HOST=127.0.0.1  # bind 127.0.0.1 by default; non-local bind requires API_TOKEN
API_PORT=8000
# SERVER-SIDE secret, never exposed to the browser (no URL, no localStorage,
# no JS, no API response). When set: non-local binds are allowed and
# Authorization: Bearer <API_TOKEN> authorizes server-to-server /api/* calls
# (scheduler/CI). Browser users authenticate with username + password
# instead (HttpOnly session cookie) — create the first user with
# `python create_user.py <username> [password]`.
API_TOKEN=
# Dedicated elevated secret for the apply-gated routes (intent/submit,
# tracker reconcile). These routes accept EITHER a valid dashboard login
# session (human-in-the-loop apply flow) OR Bearer <APPLY_API_TOKEN>
# (server-to-server). The general API_TOKEN is never accepted on them.
# Set it before any submit unlock; the browser never sees this value.
APPLY_API_TOKEN=
# Optional dedicated SQLite file for the users/sessions tables. Default is
# the apply-state DB (APPLY_STATE_DB_PATH, or data/apply_submit.db) — auth
# just adds its own tables, no new infrastructure.
# IMPORTANT: left empty, the Argon2id password hashes and live sessions live
# inside data/apply_submit.db. Backing that file up is what backs up logins,
# and losing it locks every operator out (recreate with create_user.py).
AUTH_DB_PATH=
# Apply-state database: claims, intents, review artifacts, login audit events
# (api/apply_state.py). Same file as AUTH_DB_PATH unless that is set above.
APPLY_STATE_DB_PATH=data/apply_submit.db
# Session lifetime in hours (default 168 = 7 days; clamped to 1..2160).
SESSION_TTL_HOURS=168
# Max live sessions per user (default 10, clamped to 1..1000). Going past the
# cap evicts the OLDEST session, never refuses the newest one, so an operator on
# phone + laptop + desktop is not locked out. Without a cap a stolen password
# could mint unlimited 7-day sessions with nothing to notice.
MAX_SESSIONS_PER_USER=10
# Force the session cookie's Secure flag (true/false). Empty = Secure only
# when the request arrives as https. Set true behind a TLS-terminating proxy
# (docker-compose sets it for the api service).
SESSION_COOKIE_SECURE=
# Login brute-force limits (api/ratelimit.py). Two independent sliding-window
# budgets are checked on EVERY POST /api/auth/login, before any Argon2 work:
# exceeding either answers 429 + Retry-After. Both exist because neither alone
# is sufficient — per-IP lets one attacker lock out a whole NAT'd office,
# per-username lets an attacker spray one password across accounts from
# rotating IPs. The per-USERNAME budget is cleared on a successful login (an
# operator who mistyped twice is not punished later); the per-IP one is not.
LOGIN_RATE_LIMIT=12        # attempts per window per client IP
LOGIN_USER_RATE_LIMIT=6    # attempts per window per username
LOGIN_RATE_WINDOW=600      # window in seconds (both budgets share it)
# Upper bound on accepted password length. A resource control, not just
# validation: /api/auth/login is unauthenticated, so an unbounded field lets
# one small JSON body buy a full Argon2id verify on arbitrary-length input.
# Enforced in BOTH the HTTP schema and api.auth.verify_login.
PASSWORD_MAX_LENGTH=128
# Honour X-Forwarded-For when keying the login rate limit. Leave EMPTY unless
# uvicorn is started with --proxy-headers behind a proxy you control
# (docker-compose does). Trusting a client-supplied header would let an
# attacker mint a fresh bucket per request by randomising it — worse than no
# limiter at all. With --proxy-headers on, request.client.host is already the
# real client, so this stays empty.
TRUST_PROXY_HEADERS=
# Publish /docs + /openapi.json with no session (default: gated — anonymous
# requests get 401, a logged-in browser still gets Swagger because it sends
# the session cookie same-origin). Only set true on a trusted network.
API_DOCS_ENABLED=
# Optional comma-separated override (default: localhost:3000/5173/8000/8080).
# Credentials are allowed on these origins because auth is an HttpOnly cookie,
# so each entry must be an exact `scheme://host[:port]` — no path, no trailing
# slash, no wildcard. "*" is REFUSED: with allow_credentials=True Starlette
# reflects the caller's Origin instead of rejecting the wildcard, which would
# let any website read authenticated API responses. Entries that are not usable
# are dropped at startup with a warning; if none are usable, the localhost
# defaults apply. The dashboard is served same-origin by the API and needs no
# entry here at all.
API_CORS_ORIGINS=
API_CACHE_TTL=90  # sheet cache TTL seconds, clamped to 60-120

# Reverse proxy (docker compose Caddy service) — see deploy/DEPLOY_ORACLE.md
# A real hostname enables automatic Let's Encrypt HTTPS; :80 serves plain HTTP
SITE_ADDRESS=:80
