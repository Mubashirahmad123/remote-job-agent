# Secrets & API keys (NEVER commit)
.env
keys.json
key.json
key.example.json

# Personal data
my_cv.pdf
# Uploaded CV variants (dashboard POST /api/cv/upload) — PII, never commit.
cvs/
PRODUCTION_ROADMAP.md

# Scraped / cached runtime data
scraped_jobs.json
curated_jobs.json
fresh_scrape.json
seen_jobs.json
test_scrape_output.txt
install.log
*.log
scrape_save_tmp.py
*_tmp.py

# Generated artifacts
# Anchored with a leading / on purpose. An unanchored "data/" (or "cache/",
# "resumes/", ...) matches a directory of that name at ANY depth, so a source
# directory added later is silently ignored: no diff, no error, no clue. That
# is not hypothetical - frontend/js/data/ held a file that no diff and no test
# failure ever revealed. These directories are all generated at the repo root,
# so root-only is both sufficient and safe.
/logs/
/resumes/
/cover_letters/
/apply_packages/
/email_drafts/
/screenshots/
/cache/
/data/
/archive/
# Scratch workspace for one-off PDF/layout experiments. Listed explicitly
# because the anchored artifact rules above no longer cover nested dirs —
# that is the point of anchoring them, so each real scratch/generated
# location gets named instead of hiding behind a blanket pattern.
/scratch/

# Optional semantic embeddings
*.pkl
# The CV embedding cache, both formats. This is derived from my_cv.pdf, so it
# carries the same personal data and must never be committed. The .pkl line stays
# because an operator upgrading from before the JSON switch still has one, and it
# would otherwise show up as a new untracked file.
cv_embeddings.json
cv_embeddings.pkl

# Python
venv/
.venv/
.env/
__pycache__/
*.pyc
.pytest_cache/

# VS Code
.vscode/

# Node
node_modules/

# Build files
dist/
build/

# Live-submit evidence (traces, video, HAR, post-click DOM) — never commit
data/submit_runs/
recon-*.json
